# Локальный тестовый стек (cp .env.local.example .env.local && source при запуске)
# Прод: Docker на VPS с telegram-bot.access.txt

TELEGRAM_ACCESS_FILE=telegram-bot.access.test.txt
# Отдельная Redis DB, чтобы не смешивать с другими локальными данными
REDIS_URL=redis://127.0.0.1:6379/1
APP_ENV=test
# Локально: до 500 MB (как URL_DOWNLOAD_MAX_BYTES). Прод оставляет 20 MB.
TELEGRAM_BOT_FILE_SIZE_LIMIT=524288000

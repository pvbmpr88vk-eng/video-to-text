# Ollama (local LLM for summarize) — default model fits 8 GB RAM
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b-instruct
OLLAMA_NUM_CTX=8192
SUMMARY_CHUNK_CHAR_LIMIT=6000
SUMMARY_TEMPERATURE=0.2

# Telegram bot (stage 4) — optional if telegram-bot.access.txt is filled
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ALLOWED_USER_IDS=123456789,987654321
# TELEGRAM_ACCESS_FILE=

# Optional: Hugging Face token speeds up faster-whisper model download (STT)
# HF_TOKEN=

# URL download (TZ-06, yt-dlp)
URL_DOWNLOAD_MAX_BYTES=524288000
URL_DOWNLOAD_TIMEOUT_SEC=600
# Optional: Netscape cookies.txt from browser (helps YouTube 403)
# YT_DLP_COOKIES_FILE=/path/to/cookies.txt

# Redis + job queue (TZ-05)
REDIS_URL=redis://127.0.0.1:6379/0
JOB_QUEUE_ENABLED=true
MAX_CONCURRENT_JOBS=1
MAX_STT_WORKERS_PER_JOB=1
MAX_CONCURRENT_SUMMARIES=1
MAX_QUEUE_SIZE=5
JOB_TRANSCRIPT_TIMEOUT_SEC=7200
JOB_SUMMARY_TIMEOUT_SEC=1800
JOB_MAX_RETRIES=2
JOB_RETRY_DELAY_SEC=60
JOB_CLEANUP_TTL_HOURS=24
LOG_FORMAT=text
LOG_LEVEL=INFO

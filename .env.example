# Ollama (local LLM for summarize) — default model fits 8 GB RAM
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b-instruct
OLLAMA_NUM_CTX=8192
SUMMARY_CHUNK_CHAR_LIMIT=6000
SUMMARY_TEMPERATURE=0.2

# Telegram bot (stage 4) — optional if telegram-bot.access.txt is filled
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ALLOWED_USER_IDS=
# TELEGRAM_ACCESS_FILE=

# Optional: Hugging Face token speeds up faster-whisper model download (STT)
# HF_TOKEN=

# Copy to .env on VPS: cp .env.docker.example .env
# Profile: 2 vCPU / 4 GB RAM — see deploy/env/minimal-4gb.env

REDIS_URL=redis://redis:6379/0
JOB_QUEUE_ENABLED=true

# Queue limits (4 GB VPS)
MAX_CONCURRENT_JOBS=1
MAX_STT_WORKERS_PER_JOB=1
MAX_CONCURRENT_SUMMARIES=1
MAX_QUEUE_SIZE=3

# Models (quality defaults; STT+Ollama must not peak above ~4 GB)
WHISPER_MODEL=small
OLLAMA_MODEL=qwen2.5:3b-instruct
OLLAMA_NUM_CTX=6144
# Ollama on VPS host (install separately): leave as host.docker.internal
OLLAMA_HOST=http://host.docker.internal:11434

SUMMARY_CHUNK_CHAR_LIMIT=6000
SUMMARY_TEMPERATURE=0.2

JOB_TRANSCRIPT_TIMEOUT_SEC=7200
JOB_SUMMARY_TIMEOUT_SEC=1800
JOB_CLEANUP_TTL_HOURS=24
STT_CHUNK_WHEN_ABOVE_MINUTES=12
STT_MAX_AUDIO_DURATION_MINUTES=55
WHISPER_BEAM_SIZE=1
LOG_FORMAT=json
LOG_LEVEL=INFO

# Telegram — fill before deploy
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=

# Optional: Netscape cookies for YouTube (mount in compose)
# YT_DLP_COOKIES_FILE=/app/secrets/yt_cookies.txt

# Optional TZ-09: Local Bot API (profile with-local-bot-api + docker-compose.local-bot-api.yml)
# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=
# TELEGRAM_BOT_API_BASE_URL=http://telegram-bot-api:8081
# TELEGRAM_BOT_FILE_SIZE_LIMIT=524288000
# TELEGRAM_BOT_API_CACHE_TTL_HOURS=6

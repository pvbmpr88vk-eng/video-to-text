# 2 vCPU / 4 GB RAM VPS (video-to-text production default)
# Use: cp deploy/env/minimal-4gb.env .env && edit secrets

REDIS_URL=redis://redis:6379/0
JOB_QUEUE_ENABLED=true
MAX_CONCURRENT_JOBS=1
MAX_STT_WORKERS_PER_JOB=1
MAX_CONCURRENT_SUMMARIES=1
MAX_QUEUE_SIZE=3
WHISPER_MODEL=small
OLLAMA_MODEL=qwen2.5:3b-instruct
OLLAMA_NUM_CTX=6144
OLLAMA_HOST=http://host.docker.internal:11434
LOG_FORMAT=json
LOG_LEVEL=INFO
JOB_CLEANUP_TTL_HOURS=24
# STT: chunk long audio to avoid OOM; hard cap duration (minutes)
STT_CHUNK_WHEN_ABOVE_MINUTES=12
# До ~4 ч при URL/файле до 500 MB (yt-dlp URL_DOWNLOAD_MAX_BYTES)
STT_MAX_AUDIO_DURATION_MINUTES=240
WHISPER_BEAM_SIZE=1
URL_DOWNLOAD_MAX_BYTES=524288000
URL_DOWNLOAD_TIMEOUT_SEC=1800

# GPU Sharing v3 (key in .env only — deploy/env/gpu-sharing.env.example)
GPU_SHARING_URL=http://85.198.66.114:8082
GPU_SHARING_ENABLED=true
GPU_SHARING_RUNTIME=onnx_cuda
GPU_SHARING_TEST_MODEL_URL=http://62.217.176.132:18888/mnist-12.onnx
GPU_SHARING_TRANSCRIPT=1
GPU_SHARING_STT_PUBLISH_HOST=62.217.176.132
GPU_SHARING_STT_STAGING_DIR=/staging/gpu-audio
GPU_SHARING_STT_FALLBACK_CPU=1

# Local Bot API (TZ-09). Merge into .env on VPS when enabling profile with-local-bot-api.
# Get TELEGRAM_API_ID / TELEGRAM_API_HASH from https://my.telegram.org/apps

TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Обязательно в compose (см. docker-compose.local-bot-api.yml): TELEGRAM_LOCAL=1

TELEGRAM_BOT_API_BASE_URL=http://telegram-bot-api:8081
TELEGRAM_BOT_FILE_SIZE_LIMIT=524288000
TELEGRAM_BOT_API_CACHE_TTL_HOURS=6

# GPU Sharing v3 (ONNX invoke). Copy into .env — never commit GPU_SHARING_API_KEY.
# Docs: docs/gpu-sharing.md

GPU_SHARING_URL=http://85.198.66.114:8082
GPU_SHARING_API_KEY=
GPU_SHARING_ENABLED=true
GPU_SHARING_RUNTIME=onnx_cuda
# Direct URL, no redirects (e.g. VPS http.server on :18888)
GPU_SHARING_TEST_MODEL_URL=http://YOUR_VPS:18888/mnist-12.onnx

# Prod STT: try GPU Sharing, fall back to local Whisper on VPS (v3 jobs API is off)
GPU_SHARING_TRANSCRIPT=1
GPU_SHARING_STT_PUBLISH_HOST=62.217.176.132
GPU_SHARING_STT_STAGING_DIR=/staging/gpu-audio
GPU_SHARING_STT_FALLBACK_CPU=1
